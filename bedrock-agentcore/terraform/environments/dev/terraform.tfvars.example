# FaultCast Terraform Variables - Development Environment
# Copy this file to terraform.tfvars and update with your values

# ============================================================================
# AWS Configuration
# ============================================================================
aws_region   = "eu-west-1"
environment  = "dev"
project_name = "faultcast"

# ============================================================================
# Knowledge Base Configuration
# ============================================================================

# Option 1: Create new Knowledge Base with existing S3 bucket (RECOMMENDED)
create_knowledge_base         = true
use_existing_kb_s3_bucket     = true
existing_kb_s3_bucket_name    = "your-existing-bucket-name"  # Replace with your bucket name
existing_kb_s3_bucket_arn     = "arn:aws:s3:::your-existing-bucket-name"  # Replace with your bucket ARN

# Option 2: Create new Knowledge Base with new S3 bucket
# create_knowledge_base         = true
# use_existing_kb_s3_bucket     = false

# Option 3: Use existing Knowledge Base (skip creation)
# create_knowledge_base = false
# knowledge_base_id     = "EXISTING_KB_ID"

# ============================================================================
# SageMaker Configuration
# ============================================================================
sagemaker_endpoint_name = "conveyor-fault-detection-endpoint"  # Replace with your endpoint name

# ============================================================================
# AgentCore Configuration (Optional)
# ============================================================================
# agentcore_agent_arn = "arn:aws:bedrock-agentcore:eu-west-1:ACCOUNT_ID:runtime/AGENT_ID"

# ============================================================================
# Lambda Configuration (Optional)
# ============================================================================
create_lambda_role = false  # Set to true if you need Lambda functions

# ============================================================================
# Monitoring Configuration
# ============================================================================
enable_monitoring = true

# ============================================================================
# Sensor Simulation (Optional)
# ============================================================================
sensor_simulation_schedule = "rate(1 minute)"
